# ============================================================
# MinIO Sync 环境变量模板
# 复制为 .env 并填写真实值（.env 已被 .gitignore 忽略，不会提交）
# 优先级: 默认值 < 环境变量(.env) < CLI 参数
# ============================================================

# ---- MinIO 连接（必填）----
MINIO_ENDPOINT=your-endpoint
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET=your-bucket
MINIO_LOCAL_SYNC_PATH=/path/to/local/sync

# ---- 可选覆盖项（不设置则使用内置默认值）----
# MINIO_SECURE=true
# MINIO_VERIFY_SSL=true

# MINIO_SYNC_INTERVAL=60
# MINIO_DELTA_SECONDS=30
# MINIO_MAX_THREADS=8
# MINIO_MAX_CONTINUOUS_FAIL=20
# MINIO_FUSE_RECOVERY_SECONDS=300
# MINIO_MAX_RETRY_PER_FILE=5
# MINIO_SYNC_PREFIX=
# MINIO_INITIAL_SYNC_TIME=2024-01-01T00:00:00Z

# MINIO_RECONCILIATION_INTERVAL=1800
# MINIO_EVENT_RECONNECT_DELAY=5
# MINIO_MAX_QUEUE_SIZE=10000
# MINIO_CLOCK_OFFSET_RECHECK_INTERVAL=3600

# MINIO_LOG_LEVEL=INFO
# MINIO_LOG_FILE=logs/minio_sync.log
# MINIO_LOG_MAX_BYTES=52428800
# MINIO_LOG_BACKUP_COUNT=10